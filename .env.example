# SuiSure environment. Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Anything the browser is allowed to read MUST start with VITE_.
# Anything secret MUST NOT. A VITE_-prefixed secret ends up in the public
# JavaScript bundle; treat that as a leak and rotate the key.

# --- AI endpoint (server only) ---------------------------------------------

# Google Gemini key (free tier). This is the provider the demo runs on.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite, which answers in about a second.
# gemini-3.6-flash also works but reasons first and has been measured at over
# 60 seconds on a single extraction — too slow for a live demo.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative provider. If GEMINI_API_KEY is absent and this is set,
# the endpoint uses Claude instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Optional. Milliseconds before the model call is abandoned. Default 20000.
AI_TIMEOUT_MS=20000

# Optional override: `gemini`, `anthropic`, or `heuristic`. Unset picks whichever
# vendor has a key (Gemini first) and falls back to the offline regex extractor.
# Force `heuristic` to demo with no network at all.
AI_PROVIDER=

# --- Merchant resolution ----------------------------------------------------

# `mock` uses src/services/mocks/data.ts. `chain` reads the MerchantCredential
# objects listed in src/config/sui.ts from Sui Testnet.
MERCHANT_SOURCE=chain

# --- Abuse controls ---------------------------------------------------------

# Requests per IP per minute against /api/interpret-payment. Default 10. Raise it
# locally when running scripts/ai-smoke.mjs; leave it at the default in public.
AI_RATE_LIMIT_PER_MINUTE=10

# Comma-separated origins allowed to call the API cross-origin. Same-origin
# browser calls send no Origin header and are always allowed. Empty means no
# cross-origin restriction — set it before the public URL goes out.
ALLOWED_ORIGINS=http://localhost:8080

# --- Browser-visible --------------------------------------------------------

# Where the browser posts natural-language payment requests.
VITE_AI_ENDPOINT=/api/interpret-payment
