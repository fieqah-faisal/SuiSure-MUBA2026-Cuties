# SuiSure environment. Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Anything the browser is allowed to read MUST start with VITE_.
# Anything secret MUST NOT. A VITE_-prefixed secret ends up in the public
# JavaScript bundle; treat that as a leak and rotate the key.

# --- AI endpoint (server only, Member 2) -------------------------------------

# Google Gemini API key. Server only. Get one at https://aistudio.google.com/apikey
# Without it the endpoint still answers, using the offline regex fallback, and
# /api/health reports provider "heuristic". Never describe that as AI.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (about 1.5 s per request).
# gemini-3.5-flash reasons first and was measured at 7.5 s — too slow on stage.
# gemini-2.5-flash-lite returns 404 for new keys.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Milliseconds before the model call is abandoned. Default 15000.
AI_TIMEOUT_MS=15000

# Optional. `heuristic` forces the offline extractor even when a key is set —
# use it to demo with no network at all. Unset means Gemini when a key exists.
AI_PROVIDER=

# --- Abuse controls ----------------------------------------------------------

# Requests per client address per minute against /api/interpret-payment.
# Default 10. Raise it locally to run scripts/ai-smoke.mjs without pauses.
AI_RATE_LIMIT_PER_MINUTE=10

# Requests per minute across all clients on one server instance. Default 120.
AI_RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Comma-separated extra origins allowed to call the API from a browser. The
# app's own origin is always allowed; this is only for other sites. Empty
# means no other origin.
ALLOWED_ORIGINS=

# --- Browser-visible ---------------------------------------------------------

# Where the browser posts natural-language payment requests. Same-origin by
# default; only change it if the API is hosted elsewhere.
VITE_AI_ENDPOINT=/api/interpret-payment

# --- Google zkLogin via Enoki (Member 3) --------------------------------------
# Public identifiers, safe in the bundle. Both must be set for the Google
# sign-in option to appear.
VITE_ENOKI_API_KEY=
VITE_GOOGLE_CLIENT_ID=
